# ==============================================================================
# TICKETBOOKING ENVIRONMENT CONFIGURATION TEMPLATE (5 POSTGRESQL CONTAINERS)
# ==============================================================================

# 1. AUTH SERVICE DATABASE
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5433
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=your_auth_password

# 2. USER SERVICE DATABASE
USER_DB_HOST=postgres-user
USER_DB_PORT=5434
USER_DB_NAME=user_db
USER_DB_USER=user_svc_user
USER_DB_PASSWORD=your_user_password

# 3. CATALOG SERVICE DATABASE
CATALOG_DB_HOST=postgres-catalog
CATALOG_DB_PORT=5435
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=your_catalog_password

# 4. BOOKING SERVICE DATABASE
BOOKING_DB_HOST=postgres-booking
BOOKING_DB_PORT=5436
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=your_booking_password

# 5. PAYMENT SERVICE DATABASE
PAYMENT_DB_HOST=postgres-payment
PAYMENT_DB_PORT=5437
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=your_payment_password

# 6. REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 7. MONGODB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=your_mongo_root_password
MONGO_APP_USER=notification_user
MONGO_APP_PASSWORD=your_notification_password
MONGO_DATABASE=notification_db

# 8. APACHE KAFKA & KAFKA UI
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=your_kafka_ui_password

# 9. JWT SECURITY CONFIGURATION (AUTH SERVICE) — RS256 (RSA Asymmetric Keys)
# Key KHÔNG lưu trong .env — sinh ra 2 file ở root repo rồi chỉ trỏ đường dẫn (thư mục secrets/ đã .gitignore):
#   mkdir -p secrets/jwt
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /tmp/priv.pem
#   openssl pkcs8 -topk8 -inform PEM -outform DER -in /tmp/priv.pem -nocrypt | base64 -w0 > secrets/jwt/private.key
#   openssl rsa -in /tmp/priv.pem -pubout -outform DER | base64 -w0 > secrets/jwt/public.key
# Đường dẫn tương đối theo working directory của tiến trình (mvnw -pl services/auth spring-boot:run
# chạy với cwd = services/auth) — đi lên 2 cấp tới root repo, không phụ thuộc máy/vị trí clone.
JWT_PRIVATE_KEY_PATH=../../secrets/jwt/private.key
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.key
JWT_KEY_ID=auth-key-1
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=your_access_token_expiration_seconds
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=your_refresh_token_expiration_seconds

# 10. MOMO PAYMENT GATEWAY (PAYMENT SERVICE) — Sandbox: https://developers.momo.vn
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn
# Fallback nếu client không truyền returnUrl khi gọi POST /payments/initiate
# (xem docs/api-design.md §5.1) — đây là URL của Frontend, không phải backend.
MOMO_REDIRECT_URL=https://ticketbooking.vn/payment/result
# Endpoint server-to-server MoMo gọi khi thanh toán xong (§5.2) — phải đăng ký
# đúng URL này trong MoMo Developer Portal.
MOMO_IPN_URL=http://localhost:8080/api/payments/momo/ipn

